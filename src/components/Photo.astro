---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { site } from '../data/site';

/**
 * Muestra la foto guardada en src/assets/<name>.(jpg|jpeg|png|webp|avif).
 * Si todavía no existe, enseña un marcador elegante con las iniciales.
 */
interface Props {
  name: string;
  alt: string;
  class?: string;
  widths?: number[];
  sizes?: string;
  loading?: 'eager' | 'lazy';
}

const files = import.meta.glob<{ default: ImageMetadata }>('/src/assets/*.{jpg,jpeg,png,webp,avif}', {
  eager: true,
});

const { name, alt, class: className = '', widths, sizes, loading = 'lazy' } = Astro.props;

const match = Object.entries(files).find(([path]) => path.split('/').pop()?.split('.')[0] === name);
const image = match?.[1].default;
---

{
  image ? (
    <Image src={image} alt={alt} class:list={[className, 'object-cover']} widths={widths} sizes={sizes} loading={loading} />
  ) : (
    <div class:list={['relative flex items-center justify-center overflow-hidden bg-ink/[0.07]', className]} role="img" aria-label={alt}>
      <span aria-hidden="true" class="font-display text-[clamp(5rem,14vw,9rem)] font-extrabold tracking-tight text-ink/15">
        {site.initials}
      </span>
      {import.meta.env.DEV && (
        <span class="absolute inset-x-4 bottom-4 rounded-full bg-paper px-3 py-1.5 text-center text-xs text-ink-soft">
          Añade la foto en src/assets/{name}.jpg
        </span>
      )}
    </div>
  )
}
