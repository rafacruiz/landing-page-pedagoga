---
import { site } from '../data/site';
const { services } = site;
---

<section id="servicios" class="py-20 md:py-28">
  <div class="mx-auto grid max-w-6xl gap-12 px-5 md:px-8 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-4">
      <div class="lg:sticky lg:top-28">
        <h2 class="text-4xl font-extrabold leading-[1.05] md:text-5xl">{services.title}</h2>
        <p class="mt-5 max-w-md text-lg leading-relaxed">{services.intro}</p>
        <a href="#contacto" class="link-marker mt-7 inline-block text-lg">{services.cta}</a>
      </div>
    </div>

    <ul class="divide-y divide-ink/15 border-y border-ink/15 lg:col-span-8">
      {
        services.items.map((item) => (
          <li class="grid gap-x-8 gap-y-3 py-7 sm:grid-cols-[1fr_auto]">
            <h3 class="text-2xl font-bold tracking-tight">{item.title}</h3>
            <span class="h-fit w-fit self-start rounded-full border border-ink/25 px-3 py-1 text-sm font-medium text-ink">
              {item.audience}
            </span>
            <p class="max-w-2xl leading-relaxed sm:col-span-2">{item.description}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
