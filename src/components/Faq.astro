---
import Icon from './Icon.astro';
import { site } from '../data/site';
const { faq } = site;
---

<section id="preguntas" class="border-t border-ink/10 py-20 md:py-28">
  <div class="mx-auto grid max-w-6xl gap-12 px-5 md:px-8 lg:grid-cols-12 lg:gap-16">
    <h2 class="text-4xl font-extrabold leading-[1.05] md:text-5xl lg:col-span-4">{faq.title}</h2>

    <div class="divide-y divide-ink/15 border-y border-ink/15 lg:col-span-8">
      {
        faq.items.map((item) => (
          <details class="group py-5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 font-display text-lg font-bold text-ink md:text-xl [&::-webkit-details-marker]:hidden">
              {item.question}
              <span class="grid size-9 shrink-0 place-items-center rounded-full border border-ink/25 transition-transform duration-200 group-open:rotate-45 group-open:bg-marker">
                <Icon name="plus" class="size-4" />
              </span>
            </summary>
            <p class="mt-3 max-w-2xl leading-relaxed">{item.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
