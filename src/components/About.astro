---
import Photo from './Photo.astro';
import { site } from '../data/site';
const { about } = site;
---

<section id="sobre-mi" class="bg-tint py-20 md:py-28">
  <div class="mx-auto grid max-w-6xl items-start gap-12 px-5 md:px-8 lg:grid-cols-12 lg:gap-16">
    <div class="mx-auto w-full max-w-md lg:col-span-5 lg:max-w-none">
      <Photo
        name="sobre-mi"
        alt={about.photoAlt}
        widths={[400, 640, 900]}
        sizes="(min-width: 1024px) 460px, 90vw"
        class="aspect-[4/5] w-full rounded-[2rem]"
      />
    </div>

    <div class="lg:col-span-7">
      <h2 class="text-4xl font-extrabold leading-[1.05] md:text-5xl">{about.title}</h2>

      {about.paragraphs.map((text) => <p class="mt-5 max-w-xl text-lg leading-relaxed">{text}</p>)}

      <dl class="mt-10 grid gap-x-8 gap-y-6 md:grid-cols-3">
        {
          about.principles.map((item) => (
            <div class="border-t-2 border-ink pt-4">
              <dt class="font-display text-lg font-bold text-ink">{item.title}</dt>
              <dd class="mt-2 text-[0.95rem] leading-relaxed">{item.text}</dd>
            </div>
          ))
        }
      </dl>

      <h3 class="mt-12 text-xl font-bold">{about.trainingTitle}</h3>
      <ul class="mt-4 divide-y divide-ink/15 border-y border-ink/15">
        {about.training.map((line) => <li class="py-3">{line}</li>)}
      </ul>
    </div>
  </div>
</section>
