---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Página no encontrada" noindex>
  <section class="mx-auto max-w-3xl px-5 py-28 md:px-8 md:py-36">
    <h1 class="text-5xl font-extrabold leading-[1.05] tracking-tight md:text-6xl">Esta página no existe</h1>
    <p class="mt-6 max-w-lg text-lg leading-relaxed">
      Puede que el enlace esté mal escrito o que la página ya no esté disponible.
    </p>
    <a href="/" class="btn btn-primary mt-10">Volver al inicio</a>
  </section>
</Layout>
